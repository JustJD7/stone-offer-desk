# Copy this file to .env (local dev) and also set the same keys as
# Variables in the Railway project's service settings for the live deploy.

# Postgres connection string — from Railway's Postgres service "Connect" tab
# (or any other standard Postgres, e.g. Neon, for local dev).
DATABASE_URL=postgresql://user:password@host:5432/railway

# Random 32+ character secret used to encrypt the login session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Only needed once Phase 2 (Gmail ingestion) is wired up — see worker/ingest-automail.ts.
# These live as GitHub Actions repo secrets for the live workflow, and as local
# env vars only when running scripts/gmail-auth.ts or testing the worker by hand.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional — narrows down which email the worker treats as "the AutoMail export",
# e.g. "from:stock@yourvendor.com has:attachment filename:xlsx". Defaults to any
# email with an .xlsx attachment if left unset.
GMAIL_SEARCH_QUERY=
