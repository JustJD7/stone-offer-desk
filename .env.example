# Copy this file to .env (local dev) and also set the same keys as
# Variables in your Vercel project settings for the live deploy.

# Postgres connection string (Neon, Railway, or any standard Postgres).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mailbox that receives the "Stock List" emails with the AutoMail.xlsx
# attachment (Gmail, IMAP with an app password — see SETUP.md for how this
# was confirmed to work despite Google generally blocking it for Workspace).
# Used by both the in-app "Refresh from Email" button and the hourly
# GitHub Actions worker (worker/ingest-automail.ts).
GMAIL_ADDRESS=you@yourdomain.com
GMAIL_APP_PASSWORD=
